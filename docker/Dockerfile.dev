FROM node:22-alpine

WORKDIR /app

# Install GraphicsMagick for pdf2pic
RUN apk add --no-cache graphicsmagick ghostscript

RUN npm install -g pnpm

# Copy package + lock file
COPY package.json pnpm-lock.yaml* ./

# Install ALL dependencies (dev + prod)
RUN pnpm install

# Copy all source
COPY . .

# Expose NestJS port
EXPOSE 8000

# Dev mode: Hot reload
CMD ["pnpm", "start:dev"]
