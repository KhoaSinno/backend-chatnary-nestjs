generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_DIRECT_URL")
  extensions = [vector]
}

// Model này bạn quản lý bằng Raw SQL hoặc thư viện ngoài LangChain
model embeddings {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String                 @db.Text
  metadata  Json?
  embedding Unsupported("vector")?

  // Bạn cần cột này trong DB thật để join, dù Prisma ignore
  documentId String? @db.Uuid

  @@map("embeddings")
  @@ignore
}

enum Role {
  ADMIN
  USER
  GUEST
  LIBERIAN
}

enum AccessLevelDoc {
  PUBLIC
  PRIVATE
  RESTRICTED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String  @unique
  username     String  @unique
  name         String?
  password     String
  role         Role    @default(USER)
  refreshToken String?

  // Quota management 
  storageUsed  BigInt @default(0) // Dung lượng đã dùng (bytes)
  storageLimit BigInt @default(1073741824) // Ví dụ: 1GB mặc định (bytes)

  projects          Project[]
  chats            Chat[]
  ownedDocuments   Document[]
  userQuizAttempts UserQuizAttempt[]
}

// Chat with separate messages for proper LangChain Memory integration
model Chat {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?   @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  @@index([userId])
  @@index([projectId])
}

model ChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId    String   @db.Uuid
  role      String // 'user' | 'assistant' | 'system'
  content   String   @db.Text
  metadata  Json? // citations, token usage, etc.
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Document {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // ===== Search info =====
  title         String? // Title of the document not name of file
  description   String? // AI generated short description
  authors       String[]       @default([])
  subjects      String[]       @default([])
  tags          String[]       @default([])
  documentType  String? // ebook | paper | thesis | report | slide | law | other
  publishedYear Int?
  accessLevel   AccessLevelDoc @default(PRIVATE) // public | private | restricted

  // ===== File info =====
  originalName String
  filePath     String // S3/local
  mimeType     String?
  size         Int
  pageCount    Int?

  // Processing Status (Pipeline: Upload -> OCR -> Embedding)
  status       DocumentStatus @default(PENDING)
  errorMessage String? // Error message if processing failed

  // ===== Dynamic metadata & Stat =====
  metadata  Json? // expandable unstable fields 
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // ===== Search & tracking =====
  indexedAt DateTime? // when the document was indexed for search Elasticsearch

  // ===== Relations =====
  linkedProjects ProjectResources[] // Tài liệu này đang nằm trong những project nào?

  // Ownership
  userId String @db.Uuid
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // parentChunks ParentChunk[]

  @@index([userId])
}

model Project {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  color       String? @default("#3B82F6")
  isArchived  Boolean @default(false) // soft delete - TODO:

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.Uuid
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  chats            Chat[]
  projectResources ProjectResources[]
  quizzes          Quiz[]
}

model ProjectResources {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  projectId String   @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  documentId String    @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Settings riêng cho tài liệu trong ngữ cảnh project này
  isSelected Boolean  @default(true) // User có thể tạm tắt tài liệu này khi chat 
  addedAt    DateTime @default(now())

  @@unique([projectId, documentId])
}

model Quiz {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  projectId String @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  difficulty String @default("MEDIUM") // EASY, MEDIUM, HARD
  timeLimit  Int    @default(30) // Phút

  questions QuizQuestion[]
  attempts  UserQuizAttempt[]

  createdAt DateTime @default(now())
}

model QuizQuestion {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId String @db.Uuid
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  questionText  String
  options       Json // Mảng ["A. ...", "B. ...", "C. ...", "D. ..."]
  correctAnswer String // "A", "B", "C" hoặc "D"
  explanation   String? // Giải thích tại sao đúng

  referenceChunkId String? // (Optional) Link ngược lại chunk nào trong vector store
}

model UserQuizAttempt {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   User  @relation(fields: [userId], references: [id])
  quizId String @db.Uuid
  quiz   Quiz   @relation(fields: [quizId], references: [id])

  score       Float
  userAnswers Json // Lưu lại user chọn gì: { "questionId1": "A", ... }
  startedAt   DateTime @default(now())
  finishedAt  DateTime @default(now())
}
