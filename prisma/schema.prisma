generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL_NEON")
  directUrl  = env("DATABASE_URL_NEON_DIRECT")
  extensions = [vector]
}

// Model này bạn quản lý bằng Raw SQL hoặc thư viện ngoài LangChain
model embeddings {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String                 @db.Text
  metadata  Json?
  embedding Unsupported("vector")?

  // Bạn cần cột này trong DB thật để join, dù Prisma ignore
  documentId String? @db.Uuid

  @@map("embeddings")
  @@ignore
}

enum Role {
  ADMIN
  USER
  GUEST
  LIBERIAN
}

enum AccessLevelDoc {
  PUBLIC
  PRIVATE
  RESTRICTED
}

enum DocumentStatus {
  PROCESSING
  DONE
  ERROR
}

model users {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String  @unique
  username     String  @unique
  name         String?
  password     String
  role         Role    @default(USER)
  refreshToken String?

  // Quota management 
  storageUsed  BigInt @default(0) // Dung lượng đã dùng (bytes)
  storageLimit BigInt @default(1073741824) // Ví dụ: 1GB mặc định (bytes)

  projects       projects[]
  chats          chats[]
  ownedDocuments documents[]
}

model chats {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title String @default("New Chat")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.Uuid
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?   @db.Uuid
  project   projects? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  messages Json[]

  @@index([userId])
  @@index([projectId])
}

model documents {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // ===== Search info =====
  title         String? // Title of the document not name of file
  description   String? // AI generated short description
  authors       String[]       @default([])
  subjects      String[]       @default([])
  tags          String[]       @default([])
  documentType  String? // ebook | paper | thesis | report | slide | law | other
  publishedYear Int?
  accessLevel   AccessLevelDoc @default(PRIVATE) // public | private | restricted

  // ===== File info =====
  originalName String
  filePath     String // S3/local
  mimeType     String?
  size         Int
  pageCount    Int?

  // Processing Status (Pipeline: Upload -> OCR -> Embedding)
  status DocumentStatus @default(PROCESSING) // processing | done | error

  // ===== Dynamic metadata & Stat =====
  metadata  Json? // expandable unstable fields 
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // ===== Search & tracking =====
  indexedAt DateTime? // when the document was indexed for search Elasticsearch

  // ===== Relations =====
  linkedProjects project_resources[] // Tài liệu này đang nằm trong những project nào?

  // Ownership
  userId String @db.Uuid
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model projects {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  color       String? @default("#3B82F6")
  isArchived  Boolean @default(false) // soft delete - TODO:

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.Uuid
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  chats            chats[]
  projectResources project_resources[]
}

model project_resources {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  projectId String   @db.Uuid
  project   projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  documentId String    @db.Uuid
  document   documents @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Settings riêng cho tài liệu trong ngữ cảnh project này
  isSelected Boolean  @default(true) // User có thể tạm tắt tài liệu này khi chat 
  addedAt    DateTime @default(now())

  @@unique([projectId, documentId])
}
