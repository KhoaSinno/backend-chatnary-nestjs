# Performance optimized environment variables for ChatNary RAG System

# Database configuration
POSTGRES_DB=rag_chatnary
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=1101
DATABASE_URL=postgresql+psycopg://rag_admin:1101@db:5432/rag_chatnary

# API Keys (set your actual keys)
OPENAI_API_KEY=sk-proj-sBmt...
GOOGLE_API_KEY=AIza...

# Model configuration - optimized for performance
GEMINI_MODEL=gemini-2.0-flash-exp
EMBEDDING_MODEL=text-embedding-3-small

# Performance settings
API_TIMEOUT=60
RETRIEVER_K=5
MAX_HISTORY_MESSAGES=20

# Server configuration
PORT=8000
PGVECTOR_COLLECTION=docs_collection

# Logging level
LOG_LEVEL=INFO