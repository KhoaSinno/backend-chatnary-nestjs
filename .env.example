# Performance optimized environment variables for ChatNary RAG System

# Database configuration
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://...
DATABASE_URL_NEON=postgresql://neondb_owner:...
DATABASE_URL_NEON_DIRECT=postgresql://neondb_owner:...

# API Keys (set your actual keys)
OPENAI_API_KEY=sk-proj-...
GOOGLE_API_KEY=AIzaSy...

# Model configuration - optimized for performance
GEMINI_MODEL=gemini-2.0-flash-exp
EMBEDDING_MODEL=text-embedding-3-small

# Performance settings
API_TIMEOUT=60
RETRIEVER_K=5
MAX_HISTORY_MESSAGES=20

# Server configuration
PORT=8000
PGVECTOR_COLLECTION=

# Logging level
LOG_LEVEL=INFO

# Dev settings
NODE_ENV=dev

# JWT Configuration
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=