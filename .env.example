# =============================================================================
# DATABASE CONFIGURATION - Universal PostgreSQL Setup
# =============================================================================
# Choose ONE of the following configurations based on your database provider

# -----------------------------------------------------------------------------
# Option 1: NeonDB (Serverless PostgreSQL)
# -----------------------------------------------------------------------------
# Get connection strings from: https://console.neon.tech
# Pooled connection (default for app queries):
DATABASE_URL=postgresql:/
# Direct connection (for migrations only):
DATABASE_DIRECT_URL=postgresql

# Connection pool settings
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000
DB_KEEPALIVE=true
DB_KEEPALIVE_DELAY=10000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# -----------------------------------------------------------------------------
# Option 2: Supabase (PostgreSQL as a Service)
# -----------------------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > Database
# Connection pooling (recommended for serverless):
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (for migrations):
# DATABASE_DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# DB_POOL_MAX=10
# DB_POOL_MIN=2
# DB_KEEPALIVE=true
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# -----------------------------------------------------------------------------
# Option 3: Docker / Self-Hosted PostgreSQL (Local Development)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:password@localhost:5432/chatnary
# Or use individual parameters:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=chatnary
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password

# DB_POOL_MAX=20
# DB_POOL_MIN=5
# DB_KEEPALIVE=false  # Not needed for local

# -----------------------------------------------------------------------------
# Option 4: AWS RDS PostgreSQL
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/dbname?sslmode=require
# DATABASE_DIRECT_URL=postgresql://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/dbname?sslmode=require

# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MAX=25
# DB_KEEPALIVE=true

# -----------------------------------------------------------------------------
# Option 5: Google Cloud SQL
# -----------------------------------------------------------------------------
# Using Cloud SQL Proxy (Unix socket):
# DATABASE_URL=postgresql://user:password@localhost/dbname?host=/cloudsql/project:region:instance
# Using TCP:
# DATABASE_URL=postgresql://user:password@ip-address:5432/dbname?sslmode=require
# DB_SSL=true

# -----------------------------------------------------------------------------
# Option 6: Azure Database for PostgreSQL
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user@servername:password@servername.postgres.database.azure.com:5432/dbname?sslmode=require
# DB_SSL=true
# DB_POOL_MAX=20

# =============================================================================
# PGVECTOR CONFIGURATION
# =============================================================================
PGVECTOR_TABLE=embeddings
PGVECTOR_DISTANCE_STRATEGY=cosine  # Options: cosine, innerProduct, euclidean

# =============================================================================
# API KEYS
# =============================================================================
OPENAI_API_KEY=sk-proj-your-key-here
GOOGLE_API_KEY=AIzaSy-your-key-here

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
GEMINI_MODEL=gemini-2.0-flash-exp
EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=8080
NODE_ENV=development  # Options: development, production, test

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
API_TIMEOUT=60
RETRIEVER_K=5
MAX_HISTORY_MESSAGES=20

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO  # Options: ERROR, WARN, INFO, DEBUG

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
